{
  "name": "human-population-calculator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive 3D globe of world population and diversity from a bundled, versioned dataset.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src scripts tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "bun run lint && bun run typecheck && bun run test && bun run build && bun run test:e2e",
    "fetch:dataset": "bun scripts/fetch-dataset.ts",
    "validate:dataset": "bun scripts/validate-dataset.ts"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "dependencies": {
    "react": "18",
    "react-dom": "18",
    "react-globe.gl": "^2.38.0",
    "three": "^0.186.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "1",
    "@testing-library/jest-dom": "6",
    "@testing-library/react": "16",
    "@testing-library/user-event": "14",
    "@types/bun": "^1.4.2",
    "@types/react": "18",
    "@types/react-dom": "18",
    "@types/three": "^0.186.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "happy-dom": "^20.14.5",
    "typescript": "5.6.3",
    "vite": "6",
    "vitest": "3",
    "world-atlas": "2",
    "world-countries": "^5.1.0"
  }
}
