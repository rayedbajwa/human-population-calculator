# Population Globe — environment example.
#
# This app is a static, client-side SPA that reads a bundled dataset. It makes no
# runtime network calls and requires no backend, database, API keys or secrets.
# There are therefore no required environment variables.
#
# The lines below are optional local-development knobs consumed by tooling
# (Vite / Playwright), not by the application at runtime.

# Port for `vite preview` and the Playwright E2E web server.
# Deliberately not `PORT`: the agent host reserves that variable for its own app.
PLAYWRIGHT_PORT=3454

# Base URL Playwright uses to reach the app under test.
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3454
